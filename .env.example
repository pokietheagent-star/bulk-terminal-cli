# Copy to .env in the repo root or mm-cli/. Never commit real secrets.

# Trading account public key (base58). Required for live + faucet.
# Optional in dry-run: if set, unsigned POST /account is used for inventory/PnL.
BULK_ACCOUNT=

# Agent (or account) secret. Use ONE of:
#   BULK_AGENT_SECRET          base58 secret or 64-byte keypair
#   BULK_AGENT_SECRET_PATH     file containing the secret (base58 or Solana JSON array)
BULK_AGENT_SECRET=
# BULK_AGENT_SECRET_PATH=

# Optional. If omitted, derived from the secret.
# BULK_AGENT_PUBKEY=

# Required in addition to --enable-mainnet for live mainnet. Dry-run does not need this.
# BULK_ALLOW_MAINNET=1

# Optional default network if you do not persist one via `bulk-mm network set`.
# BULK_NETWORK=testnet
